# Use the image built by GitHub Actions and pushed to GHCR
# IMPORTANT: Update this line with your actual GHCR image path
FROM ghcr.io/your-username/hermes-webui:latest

# Switch to root to perform setup
USER root

# Install persistence dependencies
RUN pip install --no-cache-dir huggingface_hub

# Hugging Face Spaces expects UID 1000
RUN usermod -u 1000 hermeswebui \
    && groupmod -g 1000 hermeswebui \
    && chown -R hermeswebui:hermeswebui /home/hermeswebui /app /uv_cache /apptoo

# Create data directory for persistence
RUN mkdir -p /app/data/hermes && chown -R hermeswebui:hermeswebui /app/data

# Copy .env file if it exists (usually provided as a secret, but this allows for local builds)
# We use a wildcard to avoid error if file doesn't exist during standard build
COPY --chown=hermeswebui:hermeswebui .env* /app/data/hermes/

# Copy the Hugging Face specific startup script
COPY --chown=hermeswebui:hermeswebui run_hf.sh /app/run_hf.sh
RUN chmod +x /app/run_hf.sh

# Set environment variables for Hugging Face
ENV PORT=7860
ENV HERMES_WEBUI_PORT=7860
EXPOSE 7860

# Switch to the non-root user
USER hermeswebui

# Set entrypoint to our persistence-enabled script
CMD ["/app/run_hf.sh"]
